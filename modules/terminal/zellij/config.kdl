// Zellij Configuration
// Matching tmux workflow with C-s prefix

default_layout "compact-git"

// Theme: colours are terminal palette indices, so zellij follows whatever
// tinty-render writes into kitty's palette. 0-7 are base00, red, green,
// yellow, blue, magenta, cyan, base05; 8 base03; 16-21 base09, base0F,
// base01, base02, base04, base06; 22/23 the accent and its hover
// [ref:shared-accent]. Focus wears the accent, the rest stays neutral.
theme "tinty"

themes {
    tinty {
        text_unselected {
            base 7
            background 0
            emphasis_0 22
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        text_selected {
            base 7
            background 19
            emphasis_0 22
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        ribbon_unselected {
            base 7
            background 19
            emphasis_0 1
            emphasis_1 7
            emphasis_2 22
            emphasis_3 5
        }
        ribbon_selected {
            base 0
            background 22
            emphasis_0 1
            emphasis_1 16
            emphasis_2 5
            emphasis_3 4
        }
        ribbon_hover {
            base 0
            background 23
            emphasis_0 1
            emphasis_1 16
            emphasis_2 5
            emphasis_3 4
        }
        table_title {
            base 22
            background 0
            emphasis_0 6
            emphasis_1 2
            emphasis_2 5
            emphasis_3 16
        }
        table_cell_unselected {
            base 7
            background 18
            emphasis_0 22
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        table_cell_selected {
            base 7
            background 19
            emphasis_0 22
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        list_unselected {
            base 7
            background 18
            emphasis_0 22
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        list_selected {
            base 7
            background 19
            emphasis_0 22
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        // Other panes: muted
        frame_unselected {
            base 8
            background 0
            emphasis_0 20
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        // The focused pane's frame and title: the accent
        frame_selected {
            base 22
            background 0
            emphasis_0 23
            emphasis_1 6
            emphasis_2 2
            emphasis_3 5
        }
        // A hovered pane, and the focused pane in a non-base mode (pane, tab,
        // resize...): the accent's variant, as for hover in the bar
        frame_highlight {
            base 23
            background 0
            emphasis_0 23
            emphasis_1 23
            emphasis_2 23
            emphasis_3 23
        }
        exit_code_success {
            base 2
            background 0
            emphasis_0 2
            emphasis_1 2
            emphasis_2 2
            emphasis_3 2
        }
        exit_code_error {
            base 1
            background 0
            emphasis_0 1
            emphasis_1 1
            emphasis_2 1
            emphasis_3 1
        }
    }
}

// Default mode
default_mode "normal"

// Copy settings
copy_command "wl-copy"
copy_clipboard "primary"

// Mouse support (enabled by default)
mouse_mode true
// Clicking an unfocused pane also sends the click into it, so a drag
// selects at once (as tmux does)
mouse_click_through true

// Simplified UI
simplified_ui false

// Pane frames
pane_frames true

// Startup tips
show_startup_tips false

// Layout directory
// layout_dir "/home/cgeorgii/.config/zellij/layouts"

// Auto layout - start at tab 1
auto_layout true

// Session serialization
session_serialization false

// Scrollback lines
scrollback_editor "nvim"

// Mirror session
mirror_session false

// Keybindings - matching tmux config
keybinds clear-defaults=true {
    // Normal mode (default)
    normal {
        // Prefix key: Ctrl-s (like tmux C-s)
        bind "Ctrl s" { SwitchToMode "tmux"; }
    }

    // Tmux mode (activated by prefix C-s)
    tmux {
        // Split panes (matching tmux config: v=horizontal, n=vertical)
        bind "v" { NewPane "Right"; SwitchToMode "normal"; }
        bind "n" { NewPane "Down"; SwitchToMode "normal"; }

        // Stacked panes: open one into the focused stack (Ctrl g groups panes)
        bind "t" { NewPane "stacked"; SwitchToMode "normal"; }

        // Rename tab
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }

        // New tab
        bind "c" { NewTab; SwitchToMode "normal"; }

        // Kill pane (no confirm, matching tmux)
        bind "x" { CloseFocus; SwitchToMode "normal"; }

        // Detach session
        bind "d" { Detach; }

        // Switch to pane mode for navigation
        bind "[" { SwitchToMode "scroll"; }

        // Session/tab tree picker, like tmux's choose-tree (zellij-tree.sh)
        bind "s" {
            Run "zellij-tree" {
                floating true
                close_on_exit true
                name "sessions"
                x "5%"
                y "5%"
                width "90%"
                height "90%"
            }
            SwitchToMode "normal"
        }

        // Toggle the workmux agent sidebar in every tab, like tmux's C-s C-n
        bind "Ctrl n" {
            Run "workmux" "sidebar" {
                floating true
                close_on_exit true
                name "workmux sidebar"
                x "40%"
                y "45%"
                width "20%"
                height "3"
            }
            SwitchToMode "normal"
        }

        // Make the focused pane's directory the session root, where new panes
        // and tabs start (like tmux's attach -c)
        bind "Enter" {
            Run "zellij-tree" "root" {
                floating true
                close_on_exit true
                name "session root"
                x "20%"
                y "40%"
                width "60%"
                height "5"
            }
            SwitchToMode "normal"
        }

        // Built-in session manager, for creating and resurrecting sessions
        bind "S" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
            }
            SwitchToMode "normal"
        }

        // Zoom/fullscreen toggle
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }

        // Switch to last tab
        bind "Space" { GoToPreviousTab; SwitchToMode "normal"; }

        // Edit scrollback in nvim
        bind "e" { EditScrollback; SwitchToMode "normal"; }

        // Tab navigation by number
        bind "1" { GoToTab 1; SwitchToMode "normal"; }
        bind "2" { GoToTab 2; SwitchToMode "normal"; }
        bind "3" { GoToTab 3; SwitchToMode "normal"; }
        bind "4" { GoToTab 4; SwitchToMode "normal"; }
        bind "5" { GoToTab 5; SwitchToMode "normal"; }
        bind "6" { GoToTab 6; SwitchToMode "normal"; }
        bind "7" { GoToTab 7; SwitchToMode "normal"; }
        bind "8" { GoToTab 8; SwitchToMode "normal"; }
        bind "9" { GoToTab 9; SwitchToMode "normal"; }

        // Return to normal mode
        bind "Ctrl c" { SwitchToMode "normal"; }
        bind "Esc" { SwitchToMode "normal"; }
    }

    // Locked mode (when nvim/vim is focused)
    locked {
        // Allow Ctrl-s to access tmux mode even when locked
        bind "Ctrl s" { SwitchToMode "tmux"; }

        // Tab navigation still works in locked mode
        bind "Alt h" { GoToPreviousTab; }
        bind "Alt l" { GoToNextTab; }
        bind "Alt c" { NewTab; }
    }

    // Global keybinds (work in any mode except tmux and locked)
    shared_except "tmux" "locked" {
        // Tab navigation and management
        bind "Alt h" { GoToPreviousTab; }
        bind "Alt l" { GoToNextTab; }
        bind "Alt c" { NewTab; }

        // Pane navigation: Ctrl-hjkl (disabled in locked mode for nvim, which
        // sends the same message). Leaves a zoomed pane, like tmux.
        bind "Ctrl h" { MessagePlugin "meld" { name "nav"; payload "left"; }; }
        bind "Ctrl j" { MessagePlugin "meld" { name "nav"; payload "down"; }; }
        bind "Ctrl k" { MessagePlugin "meld" { name "nav"; payload "up"; }; }
        bind "Ctrl l" { MessagePlugin "meld" { name "nav"; payload "right"; }; }

        // Mark the focused pane into a group, then stack, float or close the
        // group from its menu
        bind "Ctrl g" { TogglePaneInGroup; }

        // Pane resizing: Ctrl-Alt-hjkl (matching tmux M-C-hjkl)
        bind "Ctrl Alt h" { Resize "Increase Left"; }
        bind "Ctrl Alt j" { Resize "Increase Down"; }
        bind "Ctrl Alt k" { Resize "Increase Up"; }
        bind "Ctrl Alt l" { Resize "Increase Right"; }
    }

    // Pane moving: Ctrl-Shift-hjkl stacks the focused pane with its neighbour,
    // or moves it through its stack. Kept in locked mode, as nvim doesn't use
    // these keys.
    shared_except "tmux" {
        bind "Ctrl Shift h" { MessagePlugin "meld" { name "move"; payload "left"; }; }
        bind "Ctrl Shift j" { MessagePlugin "meld" { name "move"; payload "down"; }; }
        bind "Ctrl Shift k" { MessagePlugin "meld" { name "move"; payload "up"; }; }
        bind "Ctrl Shift l" { MessagePlugin "meld" { name "move"; payload "right"; }; }

        // Tab reordering: Alt-Shift-hl, alongside Alt-hl tab navigation
        bind "Alt Shift h" { MoveTab "Left"; }
        bind "Alt Shift l" { MoveTab "Right"; }
    }

    // Scroll/Copy mode (activated by C-s [)
    scroll {
        // The prefix still works here, like in tmux's copy mode
        bind "Ctrl s" { ScrollToBottom; SwitchToMode "tmux"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "Esc" { ScrollToBottom; SwitchToMode "normal"; }
        bind "q" { ScrollToBottom; SwitchToMode "normal"; }

        // Vi-style navigation
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }

        // Vi-style search
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }

        // Edit scrollback in nvim
        bind "e" { EditScrollback; SwitchToMode "normal"; }
    }

    // Rename tab mode
    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "normal"; }
        bind "Ctrl c" { UndoRenameTab; SwitchToMode "normal"; }
    }

    // Search mode
    entersearch {
        bind "Esc" { SwitchToMode "scroll"; }
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "Enter" { SwitchToMode "search"; }
    }

    search {
        bind "Ctrl s" { ScrollToBottom; SwitchToMode "tmux"; }
        bind "Esc" { ScrollToBottom; SwitchToMode "normal"; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "normal"; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
    }
}

// UI configuration
ui {
    pane_frames {
        rounded_corners false
    }
}

// Plugins
plugins {
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        triggers "nvim|vim"
        watch_triggers "fzf|zoxide|atuin"
        watch_interval "1.0"
    }
    // Built from plugins/ and documented in [file:docs/manual/src/zellij.md]
    // Pane navigation that leaves a zoomed pane
    meld location="file:~/.config/zellij/plugins/meld.wasm"
    // Tabs named after their focused pane
    autoname location="file:~/.config/zellij/plugins/autoname.wasm" {
        max_length "24"
    }
    // The status bar of the layout, configured here with the other plugins
    bar location="file:~/.config/zellij/plugins/bar.wasm" {
        branch_command "zellij-tree branch"
        // Nerd Font folder (nf-fa-folder) and branch (nf-dev-git_branch)
        session_glyph  "\u{f07b}"
        branch_glyph   "\u{e725}"
        // Clicking the session block toggles the session picker, which
        // the bar finds by its pane name
        badge_command  "zellij run --floating --close-on-exit --name sessions --x 5% --y 5% --width 90% --height 90% -- zellij-tree"
        badge_pane     "sessions"
    }
}

load_plugins {
    autolock
    meld
    autoname
}
