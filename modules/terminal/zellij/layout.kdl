// Compact layout with zjstatus in place of compact-bar, styled after tmux-gruvbox:
// session@branch block, powerline tabs, mode on the right. Colours are ANSI names
// so the bar follows the terminal palette (and thus the tinty scheme of the day);
// in base16 palettes black is the background, white the foreground.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left  "{command_badge}#[fg=white,bg=black]{tabs}"
                format_right "{mode}"
                format_space "#[bg=black]"

                // session@branch of the focused pane's directory, like the tmux status
                // line; clicking it opens the session picker, as in tmux
                command_badge_command     "zellij-tree badge"
                command_badge_format      "#[bg=white,fg=black,bold] {stdout} "
                command_badge_interval    "2"
                command_badge_rendermode  "static"
                command_badge_cwd         "{focused_pane_cwd}"
                command_badge_clickaction "zellij run --floating --close-on-exit --name sessions --x 5% --y 5% --width 90% --height 90% -- zellij-tree"

                tab_normal "#[fg=black,bg=bright_black]#[fg=white,bg=bright_black] {index} {name} #[fg=bright_black,bg=black]"
                tab_active "#[fg=black,bg=yellow]#[fg=black,bg=yellow,bold] {index} {name} #[fg=yellow,bg=black]"
                tab_rename "#[fg=black,bg=magenta]#[fg=black,bg=magenta,bold] {index} {name} #[fg=magenta,bg=black]"

                mode_normal       "#[fg=green,bg=black]#[bg=green,fg=black,bold] {name} "
                mode_locked       "#[fg=bright_black,bg=black]#[bg=bright_black,fg=white,bold] {name} "
                mode_tmux         "#[fg=red,bg=black]#[bg=red,fg=black,bold] {name} "
                mode_scroll       "#[fg=blue,bg=black]#[bg=blue,fg=black,bold] {name} "
                mode_enter_search "#[fg=blue,bg=black]#[bg=blue,fg=black,bold] {name} "
                mode_search       "#[fg=blue,bg=black]#[bg=blue,fg=black,bold] {name} "
                mode_rename_tab   "#[fg=magenta,bg=black]#[bg=magenta,fg=black,bold] {name} "
            }
        }
    }
}
