// Compact layout with our status bar (plugins/bar) in place of compact-bar.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/bar.wasm" {
                branch_command "zellij-tree branch"
                // Nerd Font folder (nf-fa-folder) and branch (nf-dev-git_branch)
                session_glyph  "\u{f07b}"
                branch_glyph   "\u{e725}"
                // Clicking the session block opens the session picker, as in tmux
                badge_command  "zellij run --floating --close-on-exit --name sessions --x 5% --y 5% --width 90% --height 90% -- zellij-tree"
            }
        }
    }
}
