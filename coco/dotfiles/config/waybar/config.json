{
  // Waybar configuration for Niri
  //
  // Layout: Gruvbox Dark theme
  // - Left: Network status + taskbar (open windows)
  // - Center: Clock/date
  // - Right: CPU, Memory, Battery, System tray
  //
  // Style: Rounded pills, transparent background, semi-transparent modules
  // Icons: Font Awesome 6 Free icons for CPU, Memory, Battery, Network
  // Taskbar: 20px icons, no app-id sorting, click to activate/middle-click to close

  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 0,

  "modules-left": ["network", "cffi/niri-taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "battery", "custom/theme", "tray"],

  "cffi/niri-taskbar": {
    "module_path": "/home/cgeorgii/.local/lib/libniri_taskbar.so"
  },

  "clock": {
    "format": "{:%e %B %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "cpu": {
    "format": "{usage}% <span size='xx-large' rise='-4000'></span>",
    "tooltip": false
  },

  "memory": {
    "format": "{}% <span size='xx-large' rise='-4000'></span>"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% <span size='xx-large' rise='-4000'></span>",
    "format-plugged": "{capacity}% <span size='xx-large' rise='-4000'></span>",
    "format-alt": "{time} {icon}",
    "format-icons": ["<span size='xx-large' rise='-4000'></span>", "<span size='xx-large' rise='-4000'></span>", "<span size='xx-large' rise='-4000'></span>", "<span size='xx-large' rise='-4000'></span>", "<span size='xx-large' rise='-4000'></span>"]
  },

  "network": {
    "format-wifi": "<span size='xx-large'></span>",
    "format-ethernet": "<span size='xx-large'></span>",
    "tooltip-format": "{ifname} via {gwaddr} <span size='xx-large'></span>",
    "format-linked": "<span size='xx-large'></span>",
    "format-disconnected": "⚠",
    "format-alt": "{ifname}: {ipaddr}/{cidr}"
  },

  "custom/theme": {
    "exec": "/home/cgeorgii/dots/coco/dotfiles/bin/theme-status.sh",
    "return-type": "json",
    "interval": 30,
    "format": "{}",
    "tooltip": true,
    "on-click": "/home/cgeorgii/dots/coco/dotfiles/bin/theme-status.sh toggle",
    "on-click-right": "/home/cgeorgii/dots/coco/dotfiles/bin/theme-status.sh menu"
  },

  "tray": {
    "spacing": 10
  }
}
